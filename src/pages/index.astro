---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostListItem from '../components/PostListItem.astro';
import Tag from '../components/Tag.astro';
import { SKILLS, EDUCATION, CERTIFICATIONS } from '../consts';
import { getProjects, getPosts } from '../lib';

const featured = (await getProjects()).filter((p) => p.data.featured);
const posts = (await getPosts()).slice(0, 3);
---

<BaseLayout>
  <Hero />

  <section class="mt-16">
    <SectionHeading title="Featured projects" href="/projects" linkLabel="All projects" />
    <div class="grid gap-4">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="mt-16">
    <SectionHeading title="Skills" />
    <dl class="grid gap-4 sm:grid-cols-[7rem_1fr]">
      {
        SKILLS.map(({ group, items }) => (
          <>
            <dt class="text-sm font-medium text-zinc-900 dark:text-zinc-100">{group}</dt>
            <dd class="flex flex-wrap gap-1.5">{items.map((s) => <Tag>{s}</Tag>)}</dd>
          </>
        ))
      }
    </dl>
  </section>

  <section class="mt-16">
    <SectionHeading title="Education" />
    {
      EDUCATION.map((e) => (
        <div class="flex flex-col justify-between gap-1 sm:flex-row sm:items-baseline">
          <div>
            <h3 class="font-medium text-zinc-900 dark:text-zinc-100">{e.school}</h3>
            <p class="text-sm">{e.degree}</p>
          </div>
          <span class="text-sm text-zinc-500 tabular-nums">{e.period}</span>
        </div>
      ))
    }
  </section>

  <section class="mt-16">
    <SectionHeading title="Certifications" />
    <ul class="divide-y divide-zinc-200 dark:divide-zinc-800">
      {
        CERTIFICATIONS.map((c) => (
          <li class="flex flex-col justify-between gap-1 py-3 sm:flex-row sm:items-baseline sm:gap-6">
            <div>
              {c.url ? (
                <a href={c.url} target="_blank" rel="noopener noreferrer" class="font-medium text-zinc-900 hover:text-emerald-700 dark:text-zinc-100 dark:hover:text-emerald-400">
                  {c.title} <span class="text-zinc-400">↗</span>
                </a>
              ) : (
                <span class="font-medium text-zinc-900 dark:text-zinc-100">{c.title}</span>
              )}
              <p class="text-sm text-zinc-500">{c.issuer}</p>
            </div>
            <span class="shrink-0 text-sm text-zinc-500 tabular-nums">{c.date}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-16">
    <SectionHeading title="Writing" href="/blog" linkLabel="All posts" />
    <ul class="divide-y divide-zinc-200 dark:divide-zinc-800">
      {posts.map((post) => <PostListItem post={post} />)}
    </ul>
  </section>
</BaseLayout>
