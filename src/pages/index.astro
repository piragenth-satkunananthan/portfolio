---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostListItem from '../components/PostListItem.astro';
import { getProjects, getPosts } from '../lib';

const featured = (await getProjects()).filter((p) => p.data.featured);
const posts = (await getPosts()).slice(0, 3);
---

<BaseLayout>
  <Hero />

  <section class="mt-16">
    <SectionHeading title="Featured projects" href="/projects" linkLabel="All projects" />
    <div class="grid gap-4 md:grid-cols-2">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="mt-16">
    <SectionHeading title="Writing" href="/blog" linkLabel="All posts" />
    <ul class="divide-y divide-zinc-200 dark:divide-zinc-800">
      {posts.map((post) => <PostListItem post={post} />)}
    </ul>
  </section>
</BaseLayout>
