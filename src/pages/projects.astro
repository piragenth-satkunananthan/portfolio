---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SOCIALS } from '../consts';
import { getProjects } from '../lib';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const other = projects.filter((p) => !p.data.featured);
---

<BaseLayout title="Projects" description="Embedded, full-stack and tooling projects by Piragenth Satkunananthan.">
  <h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">Projects</h1>
  <p class="mt-3">
    Things I've built, from helmet firmware to web platforms. Everything is open source on
    <a href={SOCIALS.github} target="_blank" rel="noopener noreferrer" class="text-emerald-700 hover:underline dark:text-emerald-400">GitHub</a>.
  </p>

  <section class="mt-12 grid gap-4">
    {featured.map((project) => <ProjectCard project={project} detailed />)}
  </section>

  {
    other.length > 0 && (
      <section class="mt-16">
        <SectionHeading title="More" />
        <div class="grid gap-4 sm:grid-cols-2">
          {other.map((project) => <ProjectCard project={project} />)}
        </div>
      </section>
    )
  }
</BaseLayout>
