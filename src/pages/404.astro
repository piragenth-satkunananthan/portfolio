---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found">
  <div class="py-16 text-center">
    <p class="text-sm font-semibold text-emerald-700 dark:text-emerald-400">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">Page not found</h1>
    <p class="mt-4">That page doesn't exist.</p>
    <a href="/" class="mt-8 inline-block text-sm font-medium text-emerald-700 hover:underline dark:text-emerald-400">← Back home</a>
  </div>
</BaseLayout>
