---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/Tag.astro';
import { SITE_TITLE } from '../../consts';
import { getProjects } from '../../lib';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, stack, repo, demo, tag, highlights, ogImage } = project.data;

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: title,
  description: summary,
  codeRepository: repo.toString(),
  programmingLanguage: stack,
  author: { '@type': 'Person', name: SITE_TITLE, url: Astro.site!.href },
};
---

<BaseLayout title={title} description={summary} ogImage={ogImage} jsonLd={[softwareSchema]}>
  <article class="mx-auto max-w-3xl">
    <a href="/projects" class="text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-200">← All projects</a>

    <header class="mt-6">
      {tag && <p class="text-sm font-medium text-emerald-700 dark:text-emerald-400">{tag}</p>}
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">{title}</h1>
      <p class="mt-4 leading-relaxed text-zinc-600 dark:text-zinc-400">{summary}</p>
      <div class="mt-4 flex flex-wrap gap-1.5">
        {stack.map((s) => <Tag>{s}</Tag>)}
      </div>
    </header>

    {
      highlights.length > 0 && (
        <section class="mt-10">
          <h2 class="text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">Highlights</h2>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-zinc-600 marker:text-zinc-400 dark:text-zinc-400">
            {highlights.map((h) => <li>{h}</li>)}
          </ul>
        </section>
      )
    }

    <div class="prose prose-zinc mt-10 max-w-none dark:prose-invert prose-a:text-emerald-700 dark:prose-a:text-emerald-400 prose-pre:bg-zinc-900">
      <Content />
    </div>

    <footer class="mt-12 flex flex-wrap gap-3">
      <a
        href={repo}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center rounded-lg bg-zinc-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-white"
      >
        View source ↗
      </a>
      {
        demo && (
          <a
            href={demo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center rounded-lg border border-zinc-300 px-4 py-2.5 text-sm font-semibold text-zinc-800 transition hover:border-zinc-400 hover:bg-zinc-50 dark:border-zinc-700 dark:text-zinc-200 dark:hover:border-zinc-600 dark:hover:bg-zinc-900"
          >
            Live demo ↗
          </a>
        )
      }
    </footer>
  </article>
</BaseLayout>
