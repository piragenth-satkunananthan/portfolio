---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Tag from '../components/Tag.astro';
import { PROFILE, ABOUT, FOCUS_AREAS, SKILLS, EDUCATION, CERTIFICATIONS, SOCIALS } from '../consts';
---

<BaseLayout title="About" description={`About ${PROFILE.name}: ${PROFILE.headline}, ${PROFILE.location}.`}>
  <div class="flex flex-wrap gap-12 [overflow-wrap:anywhere]">
    <aside class="min-w-0 max-w-full basis-64 self-start">
      <img
        src={PROFILE.avatar}
        alt={PROFILE.name}
        width="210"
        height="210"
        class="size-40 max-w-full rounded-2xl object-cover ring-1 ring-zinc-200 md:size-52 dark:ring-zinc-800"
      />
      <p class="mt-5 font-semibold text-zinc-900 dark:text-zinc-100">{PROFILE.name}</p>
      <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{PROFILE.headline}</p>
      <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{PROFILE.location}</p>
      {
        PROFILE.openToWork && (
          <p class="mt-2 inline-flex items-center gap-1.5 text-sm text-emerald-700 dark:text-emerald-400">
            <span class="size-2 rounded-full bg-emerald-500" />
            Open to work
          </p>
        )
      }
      <a href={`mailto:${SOCIALS.email}`} class="mt-4 block text-sm [overflow-wrap:anywhere] text-emerald-700 hover:underline dark:text-emerald-400">
        {SOCIALS.email}
      </a>
    </aside>

    <div class="min-w-0 flex-[1_1_26rem]">
      <h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">About me</h1>
      <div class="mt-6 max-w-2xl space-y-4 leading-relaxed">
        {ABOUT.map((p) => <p>{p}</p>)}
      </div>
      <SocialLinks class="mt-8" />

      <section class="mt-16">
        <SectionHeading title="What I work on" />
        <div class="grid gap-4 sm:grid-cols-3 md:grid-cols-1">
          {
            FOCUS_AREAS.map((area) => (
              <div class="flex flex-col rounded-xl border border-zinc-200 p-5 dark:border-zinc-800">
                <h3 class="font-semibold text-zinc-900 dark:text-zinc-100">{area.title}</h3>
                <p class="mt-2 text-sm leading-relaxed">{area.description}</p>
                <a
                  href={area.project.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-auto pt-4 text-sm font-medium text-emerald-700 hover:underline dark:text-emerald-400"
                >
                  See {area.project.label}&nbsp;↗<span class="sr-only"> (opens in a new tab)</span>
                </a>
              </div>
            ))
          }
        </div>
      </section>

      <section class="mt-16">
        <SectionHeading title="Skills" />
        <dl class="grid gap-4 sm:grid-cols-[7rem_1fr]">
          {
            SKILLS.map(({ group, items }) => (
              <>
                <dt class="text-sm font-medium text-zinc-900 dark:text-zinc-100">{group}</dt>
                <dd class="flex flex-wrap gap-1.5">{items.map((s) => <Tag>{s}</Tag>)}</dd>
              </>
            ))
          }
        </dl>
      </section>

      <section class="mt-16">
        <SectionHeading title="Education" />
        {
          EDUCATION.map((e) => (
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <div class="min-w-0 grow basis-64">
                <h3 class="font-medium text-zinc-900 dark:text-zinc-100">{e.school}</h3>
                <p class="text-sm">{e.degree}</p>
              </div>
              <span class="shrink-0 text-sm text-zinc-600 dark:text-zinc-400 tabular-nums">{e.period}</span>
            </div>
          ))
        }
      </section>

      <section class="mt-16">
        <SectionHeading title="Certifications" />
        <ul class="divide-y divide-zinc-200 dark:divide-zinc-800">
          {
            CERTIFICATIONS.map((c) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3">
                <div class="min-w-0 grow basis-64">
                  {c.url ? (
                    <a href={c.url} target="_blank" rel="noopener noreferrer" class="font-medium text-zinc-900 hover:text-emerald-700 dark:text-zinc-100 dark:hover:text-emerald-400">
                      {c.title} <span class="text-zinc-400">↗</span><span class="sr-only"> (opens in a new tab)</span>
                    </a>
                  ) : (
                    <span class="font-medium text-zinc-900 dark:text-zinc-100">{c.title}</span>
                  )}
                  <p class="text-sm text-zinc-600 dark:text-zinc-400">{c.issuer}</p>
                </div>
                <span class="shrink-0 text-sm text-zinc-600 dark:text-zinc-400 tabular-nums">{c.date}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
