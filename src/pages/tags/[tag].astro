---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostListItem from '../../components/PostListItem.astro';
import { getPosts, getTags } from '../../lib';

export async function getStaticPaths() {
  const tags = await getTags();
  return tags.map(({ tag }) => ({ params: { tag }, props: { tag } }));
}

interface Props {
  tag: string;
}

const { tag } = Astro.props;
const posts = (await getPosts()).filter((post) => post.data.tags.includes(tag));
---

<BaseLayout title={`#${tag}`} description={`Blog posts tagged “${tag}”.`}>
  <a href="/blog" class="text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-200">← All posts</a>
  <h1 class="mt-4 text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
    Posts tagged “{tag}”
  </h1>
  <ul class="mt-10 divide-y divide-zinc-200 dark:divide-zinc-800">
    {posts.map((post) => <PostListItem post={post} headingLevel="h2" />)}
  </ul>
</BaseLayout>
