---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostListItem from '../../components/PostListItem.astro';
import Tag from '../../components/Tag.astro';
import { getPosts, getTags } from '../../lib';

const posts = await getPosts();
const tags = await getTags();
---

<BaseLayout title="Blog" description="Notes on embedded systems, web development and the maths behind them.">
  <h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">Blog</h1>
  <p class="mt-3">Notes on embedded systems, web development and the maths behind them.</p>

  {
    tags.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-1.5">
        {tags.map(({ tag, count }) => (
          <Tag href={`/tags/${tag}/`}>
            {tag} <span class="text-zinc-500 dark:text-zinc-400">{count}</span>
          </Tag>
        ))}
      </div>
    )
  }

  <ul class="mt-10 divide-y divide-zinc-200 dark:divide-zinc-800">
    {posts.map((post) => <PostListItem post={post} headingLevel="h2" />)}
  </ul>
</BaseLayout>
