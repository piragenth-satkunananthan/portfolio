---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
---

<li>
  <a href={`/blog/${post.id}/`} class="group flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:gap-6">
    <FormattedDate date={post.data.pubDate} class="w-28 shrink-0 text-sm text-zinc-500 tabular-nums" />
    <div>
      <h3 class="font-medium text-zinc-900 group-hover:text-emerald-700 dark:text-zinc-100 dark:group-hover:text-emerald-400">{post.data.title}</h3>
      <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{post.data.description}</p>
    </div>
  </a>
</li>
