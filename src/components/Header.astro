---
import ThemeToggle from './ThemeToggle.astro';
import { PROFILE } from '../consts';

const links = [
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
];
const path = Astro.url.pathname;
---

<header class="flex items-center justify-between border-b border-zinc-200 py-5 dark:border-zinc-800">
  <a href="/" class="font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
    {PROFILE.name.split(' ')[0]}<span class="text-emerald-600 dark:text-emerald-400">.</span>
  </a>
  <nav class="flex flex-wrap items-center justify-end gap-1 text-sm">
    {
      links.map(({ href, label }) => (
        <a
          href={href}
          aria-current={path.startsWith(href) ? 'page' : undefined}
          class="rounded-md px-3 py-2 text-zinc-600 transition hover:text-zinc-900 aria-[current=page]:text-emerald-600 dark:text-zinc-400 dark:hover:text-zinc-100 dark:aria-[current=page]:text-emerald-400"
        >
          {label}
        </a>
      ))
    }
    <ThemeToggle />
  </nav>
</header>
