---
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  detailed?: boolean;
}
const { project, detailed = false } = Astro.props;
const { title, summary, stack, repo, demo, tag, highlights } = project.data;
---

<article class="group rounded-xl border border-zinc-200 p-5 transition hover:border-zinc-300 hover:shadow-sm dark:border-zinc-800 dark:hover:border-zinc-700">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="font-semibold text-zinc-900 dark:text-zinc-100">
      <a href={repo} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-700 dark:hover:text-emerald-400">
        {title}
      </a>
    </h3>
    {tag && <span class="text-xs font-medium text-emerald-700 dark:text-emerald-400">{tag}</span>}
  </div>
  <p class="mt-2 text-sm leading-relaxed">{summary}</p>
  {
    detailed && highlights.length > 0 && (
      <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-zinc-600 marker:text-zinc-400 dark:text-zinc-400">
        {highlights.map((h) => <li>{h}</li>)}
      </ul>
    )
  }
  <div class="mt-4 flex flex-wrap gap-1.5">
    {stack.map((s) => <Tag>{s}</Tag>)}
  </div>
  <div class="mt-4 flex gap-4 text-sm font-medium">
    <a href={repo} target="_blank" rel="noopener noreferrer" class="text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">Source ↗</a>
    {demo && <a href={demo} target="_blank" rel="noopener noreferrer" class="text-emerald-700 hover:underline dark:text-emerald-400">Live demo ↗</a>}
  </div>
</article>
