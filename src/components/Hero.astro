---
import SocialLinks from './SocialLinks.astro';
import { PROFILE, SOCIALS } from '../consts';
---

<section>
  <div class="flex flex-col items-start gap-5 sm:flex-row sm:items-center">
    <img
      src={PROFILE.avatar}
      alt={PROFILE.name}
      width="80"
      height="80"
      class="size-20 shrink-0 rounded-full object-cover ring-1 ring-zinc-200 dark:ring-zinc-800"
    />
    <div class="min-w-0">
      <h1 class="text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl dark:text-zinc-100">{PROFILE.name}</h1>
      <p class="mt-1 text-zinc-600 dark:text-zinc-400">{PROFILE.headline}</p>
      <p class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-zinc-600 dark:text-zinc-400">
        <span>{PROFILE.location}</span>
        {
          PROFILE.openToWork && (
            <span class="inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-400">
              <span class="size-2 rounded-full bg-emerald-500" />
              Open to work
            </span>
          )
        }
      </p>
    </div>
  </div>
  <div class="mt-8 max-w-3xl space-y-4 leading-relaxed">
    {PROFILE.bio.map((p) => <p>{p}</p>)}
    <p>
      <a href="/about" class="font-medium text-emerald-700 hover:underline dark:text-emerald-400">More about me →</a>
    </p>
  </div>
  <div class="mt-8 flex flex-wrap gap-3">
    <a
      href={`mailto:${SOCIALS.email}`}
      class="inline-flex items-center rounded-lg bg-emerald-700 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-800 dark:bg-emerald-500 dark:text-zinc-950 dark:hover:bg-emerald-400"
    >
      Let’s work together
    </a>
    <a
      href="/projects"
      class="inline-flex items-center rounded-lg border border-zinc-300 px-4 py-2.5 text-sm font-semibold text-zinc-800 transition hover:border-zinc-400 hover:bg-zinc-50 dark:border-zinc-700 dark:text-zinc-200 dark:hover:border-zinc-600 dark:hover:bg-zinc-900"
    >
      Explore my projects
    </a>
  </div>
  <SocialLinks class="mt-4" includeEmail={false} subtle />
</section>
